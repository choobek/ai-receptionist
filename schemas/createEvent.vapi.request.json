{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "slotStart",
    "slotEnd",
    "timezone",
    "patient"
  ],
  "properties": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "consultation",
            "urgent_consultation",
            "implant_consultation",
            "orthodontic_consultation",
            "aesthetic_consultation",
            "hygiene"
          ],
          "description": "Service ID."
        },
        "name": {
          "type": "string",
          "description": "Optional human-readable service name."
        }
      }
    },
    "slotStart": {
      "type": "string",
      "description": "Exact start timestamp copied verbatim from checkAvailability slot.start."
    },
    "slotEnd": {
      "type": "string",
      "description": "Exact end timestamp copied verbatim from checkAvailability slot.end. Never infer it from duration or the spoken label."
    },
    "timezone": {
      "type": "string",
      "description": "Always use Europe/Warsaw."
    },
    "language": {
      "type": "string",
      "enum": [
        "pl",
        "en"
      ],
      "description": "Conversation language for the automatic booking confirmation SMS."
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "phoneE164"
      ],
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Patient full name."
        },
        "phoneE164": {
          "type": "string",
          "description": "Confirmed callback number stored on the booking. If the caller confirmed using the number they are calling from, reuse that live caller number here."
        },
        "isExistingPatient": {
          "type": "boolean",
          "description": "Whether the caller is already a patient."
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "phone",
        "manual"
      ],
      "description": "Booking source."
    },
    "telephony": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callerPhoneE164": {
          "type": "string",
          "description": "Optional live caller number in E.164 format when Vapi exposes it."
        },
        "callerPhoneRaw": {
          "type": "string",
          "description": "Optional raw live caller number."
        },
        "callerPhoneSource": {
          "type": "string",
          "description": "Optional source label for the live caller number."
        }
      }
    }
  }
}
