{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lookupPatient response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "found",
    "message"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "found": {
      "type": "boolean"
    },
    "matchedBy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "phone",
        "full_name",
        null
      ]
    },
    "patient": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "patientId": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "phoneE164": {
          "type": "string"
        },
        "isExistingPatient": {
          "type": "boolean"
        }
      }
    },
    "phone": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "normalizedE164": {
          "type": [
            "string",
            "null"
          ]
        },
        "spoken": {
          "type": [
            "string",
            "null"
          ]
        },
        "readbackPrompt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "examples": [
    {
      "requestId": "req_lookup_001",
      "found": true,
      "matchedBy": "phone",
      "patient": {
        "patientId": "poc_001",
        "fullName": "Anna Kowalska",
        "phoneE164": "+48500111001",
        "isExistingPatient": true
      },
      "phone": {
        "normalizedE164": "+48500111001",
        "spoken": "piec zero zero, jeden jeden jeden, zero zero jeden",
        "readbackPrompt": "Dziekuje. Powtarzam numer: piec zero zero, jeden jeden jeden, zero zero jeden. Czy wszystko sie zgadza?"
      },
      "message": "Numer telefonu jest gotowy do potwierdzenia. Dodatkowo widze pacjenta w proof-of-concept registry."
    }
  ]
}
