{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "createReceptionTask request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskType",
    "patient"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "existing_patient_booking",
        "reschedule_or_cancel",
        "urgent_case",
        "general_follow_up"
      ]
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fullName",
        "phoneE164"
      ],
      "properties": {
        "fullName": {
          "type": "string"
        },
        "phoneE164": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{7,14}$"
        },
        "isExistingPatient": {
          "type": "boolean"
        }
      }
    },
    "serviceBucket": {
      "type": "string",
      "enum": [
        "consultation",
        "urgent_consultation",
        "implant_consultation",
        "orthodontic_consultation",
        "aesthetic_consultation",
        "hygiene",
        "unknown"
      ]
    },
    "preferredCallbackWindow": {
      "type": "string",
      "enum": [
        "asap",
        "morning",
        "afternoon",
        "evening",
        "any"
      ]
    },
    "telephony": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callerPhoneE164": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{7,14}$"
        },
        "callerPhoneRaw": {
          "type": "string",
          "maxLength": 64
        },
        "callerPhoneSource": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "sourceCallId": {
      "type": "string"
    }
  },
  "examples": [
    {
      "requestId": "req_task_001",
      "taskType": "existing_patient_booking",
      "patient": {
        "fullName": "Anna Kowalska",
        "phoneE164": "+48500111001",
        "isExistingPatient": true
      },
      "serviceBucket": "hygiene",
      "preferredCallbackWindow": "morning",
      "telephony": {
        "callerPhoneE164": "+48500111001",
        "callerPhoneSource": "customer.number"
      }
    }
  ]
}
