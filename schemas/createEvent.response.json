{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "createEvent response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created",
    "message"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "created": {
      "type": "boolean"
    },
    "calendarEventId": {
      "type": "string"
    },
    "appointment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calendarId": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "patient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fullName": {
              "type": "string"
            },
            "phoneE164": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        }
      }
    },
    "phoneContext": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "declaredPhoneE164": {
          "type": [
            "string",
            "null"
          ]
        },
        "callerPhoneE164": {
          "type": [
            "string",
            "null"
          ]
        },
        "callerPhoneSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "callerMatchesDeclaredPhone": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "examples": [
    {
      "requestId": "req_002",
      "created": true,
      "calendarEventId": "4pk5u3bdq1q58v7o8dr7sodfkg",
      "appointment": {
        "calendarId": "primary",
        "start": "2026-03-12T09:00:00+01:00",
        "end": "2026-03-12T09:30:00+01:00",
        "timezone": "Europe/Warsaw",
        "service": {
          "id": "consultation",
          "name": "Konsultacja"
        },
        "patient": {
          "fullName": "Jan Kowalski",
          "phoneE164": "+48500100200",
          "email": "jan@example.com"
        }
      },
      "phoneContext": {
        "declaredPhoneE164": "+48500100200",
        "callerPhoneE164": "+48500100200",
        "callerPhoneSource": "customer.number",
        "callerMatchesDeclaredPhone": true
      },
      "message": "Wizyta zostala potwierdzona."
    }
  ]
}
