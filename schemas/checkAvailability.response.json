{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checkAvailability response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "available",
    "timezone",
    "slots",
    "message"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "available": {
      "type": "boolean"
    },
    "timezone": {
      "type": "string"
    },
    "normalizedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "durationMinutes",
        "windowStart",
        "windowEnd"
      ],
      "properties": {
        "serviceId": {
          "type": "string"
        },
        "durationMinutes": {
          "type": "integer"
        },
        "windowStart": {
          "type": "string",
          "format": "date-time"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time"
        },
        "requestedDate": {
          "type": "string",
          "format": "date"
        },
        "requestedTime": {
          "type": "string"
        },
        "timePreference": {
          "type": "string"
        },
        "searchDays": {
          "type": "integer"
        }
      }
    },
    "slots": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "label",
          "spokenDate",
          "spokenTime",
          "spokenLabel"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "label": {
            "type": "string"
          },
          "spokenDate": {
            "type": "string"
          },
          "spokenTime": {
            "type": "string"
          },
          "spokenLabel": {
            "type": "string"
          },
          "calendarId": {
            "type": "string"
          }
        }
      }
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "examples": [
    {
      "requestId": "req_001",
      "available": true,
      "timezone": "Europe/Warsaw",
      "normalizedRequest": {
        "serviceId": "consultation",
        "durationMinutes": 45,
        "windowStart": "2026-03-12T09:00:00+01:00",
        "windowEnd": "2026-03-12T13:00:00+01:00",
        "requestedDate": "2026-03-12",
        "requestedTime": null,
        "timePreference": "morning",
        "searchDays": 1
      },
      "slots": [
        {
          "start": "2026-03-12T09:00:00+01:00",
          "end": "2026-03-12T09:45:00+01:00",
          "label": "Czwartek 12 marca o 09:00",
          "spokenDate": "czwartek, dwunastego marca",
          "spokenTime": "o dziewiatej",
          "spokenLabel": "czwartek, dwunastego marca o dziewiatej",
          "calendarId": "primary"
        }
      ],
      "message": "Znalazlam kilka dostepnych terminow."
    },
    {
      "requestId": "req_002",
      "available": true,
      "timezone": "Europe/Warsaw",
      "normalizedRequest": {
        "serviceId": "consultation",
        "durationMinutes": 45,
        "windowStart": "2026-03-12T14:30:00+01:00",
        "windowEnd": "2026-03-18T21:00:00+01:00",
        "requestedDate": "2026-03-12",
        "requestedTime": null,
        "timePreference": "first_available",
        "searchDays": 5
      },
      "slots": [
        {
          "start": "2026-03-13T09:00:00+01:00",
          "end": "2026-03-13T09:45:00+01:00",
          "label": "Piatek 13 marca o 09:00",
          "spokenDate": "piatek, trzynastego marca",
          "spokenTime": "o dziewiatej",
          "spokenLabel": "piatek, trzynastego marca o dziewiatej",
          "calendarId": "primary"
        }
      ],
      "message": "Znalazlam kilka dostepnych terminow."
    }
  ]
}
