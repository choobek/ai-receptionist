{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sendSmsToPatient response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted",
    "delivery",
    "message"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "accepted": {
      "type": "boolean"
    },
    "recipientClass": {
      "type": "string",
      "enum": [
        "caller_phone",
        "declared_phone"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider",
        "recipientCount"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "simulated",
            "queued",
            "sent",
            "failed"
          ]
        },
        "provider": {
          "type": "string"
        },
        "recipientCount": {
          "type": "integer",
          "minimum": 0
        },
        "providerMessageId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sms": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "message": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "examples": [
    {
      "requestId": "req_sms_patient_001",
      "accepted": true,
      "recipientClass": "declared_phone",
      "delivery": {
        "status": "simulated",
        "provider": "mock",
        "recipientCount": 1,
        "providerMessageId": null
      },
      "sms": {
        "kind": "booking_confirmation",
        "language": "pl"
      },
      "message": "Potwierdzenie SMS dla pacjenta zostalo przygotowane."
    }
  ]
}
