{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Repo: Check Health",
      "type": "shell",
      "command": "./scripts/check-repo-health.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "n8n: Sync Workflow Data",
      "type": "shell",
      "command": "./scripts/sync-n8n-workflow-data.sh",
      "args": [
        "sync"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "n8n: Check Workflow Data Sync",
      "type": "shell",
      "command": "./scripts/sync-n8n-workflow-data.sh",
      "args": [
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Test: Run Staging Regression Suite",
      "type": "shell",
      "command": "./scripts/run-staging-regression-suite.sh",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Test: Run Staging Voice Smoke Suite",
      "type": "shell",
      "command": "./scripts/run-staging-voice-smoke-suite.sh",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Test: List Staging Voice Smoke Fixtures",
      "type": "shell",
      "command": "./scripts/run-staging-voice-smoke-suite.sh",
      "args": [
        "--list"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Test: Run Staging SMS Delivery Suite",
      "type": "shell",
      "command": "./scripts/run-staging-sms-delivery-suite.sh",
      "args": [
        "--provider",
        "${input:smsProvider}"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Sync Prompt Mirrors",
      "type": "shell",
      "command": "./scripts/sync-vapi-prompt-mirrors.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Import Prompt Mirrors",
      "type": "shell",
      "command": "./scripts/import-vapi-prompt-mirrors.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Import System Prompt Mirror",
      "type": "shell",
      "command": "./scripts/import-vapi-prompt-mirrors.sh --system-only",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Import First Message Mirror",
      "type": "shell",
      "command": "./scripts/import-vapi-prompt-mirrors.sh --first-only",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Sync Observability Mirrors",
      "type": "shell",
      "command": "./scripts/sync-vapi-observability-mirrors.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Sync Observability",
      "type": "shell",
      "command": "./scripts/sync-vapi-observability.sh",
      "args": [
        "${input:environment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Sync Environment",
      "type": "shell",
      "command": "./scripts/sync-vapi-environment.sh",
      "args": [
        "${input:environment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Run Eval Suite",
      "type": "shell",
      "command": "./scripts/run-vapi-eval-suite.sh",
      "args": [
        "staging"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Vapi: Run Live Autoeval",
      "type": "shell",
      "command": "./scripts/run-vapi-live-autoeval.sh",
      "args": [
        "${input:environment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "n8n: Import Workflows To VPS",
      "type": "shell",
      "command": "./scripts/import-n8n-workflows-vps.sh",
      "args": [
        "${input:environment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "n8n: Reconcile Workflows On VPS",
      "type": "shell",
      "command": "./scripts/reconcile-n8n-workflows-vps.sh",
      "args": [
        "${input:environment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Deploy: VPS",
      "type": "shell",
      "command": "./scripts/deploy-vps.sh",
      "args": [
        "${input:environment}",
        "${input:deployGitRef}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Environment: Full Sync",
      "type": "shell",
      "command": "./scripts/sync-environment.sh",
      "args": [
        "${input:environment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Release: Promote To Production",
      "type": "shell",
      "command": "./scripts/promote-to-production.sh",
      "args": [
        "${input:promoteGitRef}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "environment",
      "type": "pickString",
      "description": "Target environment",
      "options": [
        "staging",
        "production"
      ]
    },
    {
      "id": "smsProvider",
      "type": "pickString",
      "description": "SMS provider mode for the staging delivery suite",
      "options": [
        "mock",
        "webhook",
        "twilio"
      ]
    },
    {
      "id": "deployGitRef",
      "type": "promptString",
      "description": "Optional git ref to deploy. Leave blank to use the current remote branch on the VPS.",
      "default": ""
    },
    {
      "id": "promoteGitRef",
      "type": "promptString",
      "description": "Git ref or commit to promote to production"
    }
  ]
}
