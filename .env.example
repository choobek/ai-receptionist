# Shared
TZ=Europe/Warsaw
CLINIC_NAME=Demo Dental Clinic
CLINIC_TIMEZONE=Europe/Warsaw
GOOGLE_CALENDAR_ID=primary

# Scheduling defaults
CLINIC_WORKING_HOURS_START=08:00
CLINIC_WORKING_HOURS_END=18:00
DEFAULT_APPOINTMENT_DURATION_MINUTES=30
DEFAULT_SLOT_INCREMENT_MINUTES=30
DEFAULT_SLOT_SEARCH_LIMIT=3

# n8n webhook URLs
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
LOOKUP_PATIENT_WEBHOOK_PATH=ai-receptionist/lookup-patient
CHECK_AVAILABILITY_WEBHOOK_PATH=ai-receptionist/check-availability
SEARCH_KNOWLEDGE_BASE_WEBHOOK_PATH=ai-receptionist/search-knowledge-base
CREATE_EVENT_WEBHOOK_PATH=ai-receptionist/create-event
CREATE_RECEPTION_TASK_WEBHOOK_PATH=ai-receptionist/create-reception-task

# Vapi setup references
VAPI_ASSISTANT_LANGUAGE=pl-PL
VAPI_TOOL_LOOKUP_PATIENT_NAME=lookupPatient
VAPI_TOOL_CHECK_AVAILABILITY_NAME=checkAvailability
VAPI_TOOL_SEARCH_KNOWLEDGE_BASE_NAME=searchKnowledgeBase
VAPI_TOOL_CREATE_EVENT_NAME=createEvent
VAPI_TOOL_CREATE_RECEPTION_TASK_NAME=createReceptionTask

# Note:
# Store actual Google credentials inside n8n credentials, not in this file.
