# Shared clinic settings
TZ=Europe/Warsaw
CLINIC_NAME="Demo Dental Clinic"
CLINIC_TIMEZONE=Europe/Warsaw
GOOGLE_CALENDAR_ID=primary

# Scheduling defaults
CLINIC_WORKING_HOURS_START=09:00
CLINIC_WORKING_HOURS_END=21:00
CLINIC_OPEN_WEEKDAYS=1,2,3,4,5
DEFAULT_APPOINTMENT_DURATION_MINUTES=45
DEFAULT_SLOT_INCREMENT_MINUTES=15
DEFAULT_SLOT_SEARCH_LIMIT=3

# Local n8n defaults
N8N_HOST=localhost
N8N_PORT=5680
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5680/
N8N_EDITOR_BASE_URL=http://localhost:5680/

# Optional runtime identity for a deployed target
AI_RECEPTIONIST_DEPLOY_ENV=local
N8N_CONTAINER_NAME=ai-receptionist-n8n
N8N_DATA_VOLUME_NAME=ai-receptionist-n8n-data

# VPS / public runtime deployment
N8N_DOMAIN=n8n.example.com
LETSENCRYPT_EMAIL=ops@example.com
CADDY_ADMIN_USER=admin
CADDY_ADMIN_PASSWORD_HASH=replace-with-caddy-bcrypt-hash
N8N_PROXY_HOPS=1
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_CONTAINER_NAME=ai-receptionist-caddy
CADDY_DATA_VOLUME_NAME=ai-receptionist-caddy-data
CADDY_CONFIG_VOLUME_NAME=ai-receptionist-caddy-config

# n8n runtime
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-a-strong-password
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
AI_RECEPTIONIST_WEBHOOK_SECRET=
AI_RECEPTIONIST_SMS_PROVIDER=mock
# Used only in webhook mode.
AI_RECEPTIONIST_SMS_WEBHOOK_URL=
AI_RECEPTIONIST_SMS_WEBHOOK_BEARER_TOKEN=
AI_RECEPTIONIST_SMS_WEBHOOK_TIMEOUT_MS=10000
# Used by mock/webhook mode. Twilio mode uses TWILIO_PHONE_NUMBER instead.
AI_RECEPTIONIST_SMS_SENDER=ipokrzyku.pl
AI_RECEPTIONIST_RECEPTION_SMS_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional when the account has exactly one incoming number; scripts and workflows can auto-discover it.
TWILIO_PHONE_NUMBER=

# Shared Vapi API access
VAPI_API_KEY=
VAPI_API_BASE_URL=https://api.vapi.ai
VAPI_ASSISTANT_CONFIG_PATH=./configs/vapi/assistant.v1.json
VAPI_ASSISTANT_LANGUAGE=pl-PL
VAPI_PUBLIC_KEY=
VAPI_WEB_TOKEN=

# Voice fixture generation for the staging voice smoke suite
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_POLISH_VOICE_ID=EmspiS7CSUabPeqBcrAP
ELEVENLABS_ENGLISH_VOICE_ID=hpp4J3VqNfWAUOO0d1Us

# Staging Vapi bindings and deploy automation
STAGING_VAPI_API_KEY=
STAGING_VAPI_PUBLIC_KEY=
STAGING_VAPI_WEB_TOKEN=
STAGING_N8N_PUBLIC_BASE_URL=https://staging-n8n.example.com
STAGING_AI_RECEPTIONIST_WEBHOOK_SECRET=
STAGING_VPS_SSH_HOST=
STAGING_VPS_SSH_USER=
STAGING_VPS_SSH_PORT=22
STAGING_VPS_SSH_IDENTITY_FILE=
STAGING_VPS_APP_DIR=/home/your-user/ai-receptionist-staging
STAGING_VPS_GIT_REMOTE_SSH_URL=git@github.com:choobek/ai-receptionist.git
STAGING_VPS_N8N_CONTAINER_NAME=
STAGING_VPS_COMPOSE_FILE=deploy/vps/docker-compose.n8n-only.yml
STAGING_VPS_COMPOSE_PROJECT_NAME=ai-receptionist-staging

# Production Vapi bindings and deploy automation
PRODUCTION_VAPI_API_KEY=
PRODUCTION_VAPI_PUBLIC_KEY=
PRODUCTION_VAPI_WEB_TOKEN=
PRODUCTION_N8N_PUBLIC_BASE_URL=https://n8n.example.com
PRODUCTION_AI_RECEPTIONIST_WEBHOOK_SECRET=
PRODUCTION_VPS_SSH_HOST=
PRODUCTION_VPS_SSH_USER=
PRODUCTION_VPS_SSH_PORT=22
PRODUCTION_VPS_SSH_IDENTITY_FILE=
PRODUCTION_VPS_APP_DIR=/home/your-user/ai-receptionist
PRODUCTION_VPS_GIT_REMOTE_SSH_URL=git@github.com:choobek/ai-receptionist.git
PRODUCTION_VPS_N8N_CONTAINER_NAME=
PRODUCTION_VPS_COMPOSE_FILE=deploy/vps/docker-compose.yml
PRODUCTION_VPS_COMPOSE_PROJECT_NAME=ai-receptionist-production

# Legacy production fallbacks for older one-environment scripts
VPS_SSH_HOST=
VPS_SSH_USER=
VPS_SSH_PORT=22
VPS_SSH_IDENTITY_FILE=
VPS_APP_DIR=/home/your-user/ai-receptionist
VPS_N8N_CONTAINER_NAME=ai-receptionist-n8n
VPS_GIT_REMOTE_SSH_URL=git@github.com:choobek/ai-receptionist.git
VPS_COMPOSE_FILE=deploy/vps/docker-compose.yml
VPS_COMPOSE_PROJECT_NAME=ai-receptionist-production

# If VPS_SSH_IDENTITY_FILE is empty, ssh will use password authentication
# and prompt for the password interactively.

# Notes:
# - Use one root .env file locally for scripts and local n8n.
# - Each deployed staging/production target should still keep its own root .env on
#   that host with the unprefixed runtime values above.
# - If staging shares the production host, use STAGING_VPS_COMPOSE_FILE=deploy/vps/docker-compose.n8n-only.yml
#   and a distinct STAGING_VPS_COMPOSE_PROJECT_NAME so Docker Compose does not treat both app dirs as one project.
# - For an existing production installation that already uses a different Compose project name, set
#   PRODUCTION_VPS_COMPOSE_PROJECT_NAME to the current live project name before using the new deploy script.
#   Add STAGING_N8N_DOMAIN plus STAGING_N8N_UPSTREAM to the production host's root .env
#   so the shared Caddy instance can proxy a staging hostname to the isolated staging n8n container
#   over the shared Docker network, for example STAGING_N8N_UPSTREAM=staging-n8n:5678.
# - Set PRODUCTION_AI_RECEPTIONIST_WEBHOOK_SECRET and STAGING_AI_RECEPTIONIST_WEBHOOK_SECRET
#   to match the corresponding deployed n8n runtime secret when you protect those
#   public webhook URLs in Vapi.
# - For local HTTP keep N8N_SECURE_COOKIE=false.
# - For VPS behind HTTPS set N8N_SECURE_COOKIE=true and N8N_BASIC_AUTH_ACTIVE=false if Caddy handles editor auth.
