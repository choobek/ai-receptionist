{
  "schema_version": "staging-voice-scenario.v1",
  "scenario_id": "mid-sentence-pause-no-barge-in",
  "title": "Mid-sentence pause does not trigger assistant barge-in",
  "description": "The caller pauses for 2.5 seconds in the middle of an implant question. The assistant should stay silent during the gap and answer only after the question is complete.",
  "status": "active",
  "environment": "staging",
  "language": "pl",
  "tags": [
    "voice",
    "interruption",
    "pause-window",
    "smoke"
  ],
  "source": {
    "origin": "manual_voice_test",
    "references": [
      "docs/test-scenario-2026-03-17-implant-inquiry-to-booking.md",
      "docs/test-scenario-2026-03-17-implant-booking-retry.md",
      "docs/real-call-evaluation-2026-03-17-implant-booking-retry.md"
    ]
  },
  "runner": {
    "provider": "vapi_web_call",
    "max_duration_seconds": 100,
    "post_call_settle_seconds": 5,
    "artifact_poll_seconds": 2,
    "artifact_poll_attempts": 15
  },
  "steps": [
    {
      "step_id": "wait-for-greeting",
      "type": "pause",
      "duration_ms": 14000,
      "notes": "Leave enough space for the assistant greeting before the caller begins speaking."
    },
    {
      "step_id": "partial-question",
      "type": "play_clip",
      "clip_path": "autonomy/scenarios/staging-voice/fixtures/mid-sentence/part-1.wav",
      "transcript": "A co jeśli"
    },
    {
      "step_id": "mid-sentence-gap",
      "type": "pause",
      "duration_ms": 2500,
      "window_id": "mid-sentence-gap",
      "notes": "Intentional pause mid-sentence. The assistant must not take the turn during this gap."
    },
    {
      "step_id": "complete-question",
      "type": "play_clip",
      "clip_path": "autonomy/scenarios/staging-voice/fixtures/mid-sentence/part-2.wav",
      "transcript": "mam jeszcze część własnych zębów. Czy nadal mogę zrobić leczenie All on four?"
    },
    {
      "step_id": "listen-after-question",
      "type": "pause",
      "duration_ms": 18000,
      "notes": "Allow time for the assistant to answer after the gap closes."
    },
    {
      "step_id": "wait-for-end",
      "type": "wait_for_call_end",
      "timeout_ms": 100000
    }
  ],
  "rubric": [
    {
      "criterion_id": "no-barge-in-during-gap",
      "description": "The assistant should not speak while the caller is intentionally paused mid-sentence.",
      "severity": "critical",
      "root_cause_hint": "endpointing_or_interruption_behavior_changed",
      "rule": {
        "type": "assistant_did_not_speak_during_window",
        "window_id": "mid-sentence-gap"
      }
    },
    {
      "criterion_id": "assistant-responded-after-gap",
      "description": "The assistant should answer after the caller finishes the question.",
      "severity": "high",
      "root_cause_hint": "assistant_failed_to_resume_after_pause",
      "rule": {
        "type": "assistant_spoke_after_window",
        "window_id": "mid-sentence-gap"
      }
    },
    {
      "criterion_id": "no-booking-on-question-only",
      "description": "A question-only call should not create a booking.",
      "severity": "critical",
      "root_cause_hint": "assistant_advanced_to_booking_without_caller_intent",
      "rule": {
        "type": "tool_not_called",
        "tool_name": "createEvent"
      }
    },
    {
      "criterion_id": "no-reception-task-on-question-only",
      "description": "A question-only call should not create a reception follow-up task.",
      "severity": "high",
      "root_cause_hint": "assistant_routed_question_to_reception_unnecessarily",
      "rule": {
        "type": "tool_not_called",
        "tool_name": "createReceptionTask"
      }
    }
  ]
}
