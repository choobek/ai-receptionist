{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Staging voice run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_run_id",
    "scenario_id",
    "environment",
    "started_at",
    "completed_at",
    "status",
    "call",
    "artifacts",
    "steps",
    "event_trace",
    "tool_trace",
    "criteria",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "staging-voice-run.v1"
    },
    "suite_run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "environment": {
      "const": "staging"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "error"
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "assistant_id",
        "web_call_url",
        "started_at",
        "ended_at",
        "ended_reason",
        "status",
        "duration_seconds"
      ],
      "properties": {
        "call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "assistant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "web_call_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ended_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_call_path",
        "normalized_run_path",
        "events_path"
      ],
      "properties": {
        "raw_call_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_run_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "events_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "step_id",
          "type",
          "status"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "step_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "timed_out",
              "skipped"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "event_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "source",
          "type"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "browser",
              "client",
              "server",
              "api",
              "runner"
            ]
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "seconds_from_start": {
            "type": [
              "number",
              "null"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "payload": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "tool_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "tool_name",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "step_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_name": {
            "type": "string"
          },
          "tool_call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "missing_result"
            ]
          },
          "arguments": {
            "type": [
              "object",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "description",
          "severity",
          "required",
          "passed",
          "failure_reason",
          "root_cause_hint",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "root_cause_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_count",
        "warning_count",
        "booking_created",
        "reception_task_created",
        "structured_output_found",
        "ended_reason",
        "failure_type",
        "suspected_root_cause",
        "failure_reason",
        "tool_summary",
        "structured_output_summary",
        "transcript_excerpt",
        "event_excerpt"
      ],
      "properties": {
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "booking_created": {
          "type": "boolean"
        },
        "reception_task_created": {
          "type": "boolean"
        },
        "structured_output_found": {
          "type": "boolean"
        },
        "ended_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "assistant_behavior_failure",
            "transport_failure",
            "runner_failure",
            null
          ]
        },
        "suspected_root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_calls",
            "distinct_tool_count",
            "tools"
          ],
          "properties": {
            "total_calls": {
              "type": "integer",
              "minimum": 0
            },
            "distinct_tool_count": {
              "type": "integer",
              "minimum": 0
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool_name",
                  "call_count",
                  "completed_calls",
                  "missing_result_calls"
                ],
                "properties": {
                  "tool_name": {
                    "type": "string"
                  },
                  "call_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "completed_calls": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "missing_result_calls": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "structured_output_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "found",
            "output_id",
            "output_name",
            "call_outcome",
            "successful_for_assistant_scope",
            "short_summary",
            "short_summary_pl",
            "short_summary_en"
          ],
          "properties": {
            "found": {
              "type": "boolean"
            },
            "output_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "call_outcome": {
              "type": [
                "string",
                "null"
              ]
            },
            "successful_for_assistant_scope": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "short_summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "short_summary_pl": {
              "type": [
                "string",
                "null"
              ]
            },
            "short_summary_en": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "transcript_excerpt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_excerpt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  }
}
