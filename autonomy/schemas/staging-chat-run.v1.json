{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Staging chat run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_run_id",
    "scenario_id",
    "environment",
    "started_at",
    "completed_at",
    "status",
    "transcript",
    "tool_trace",
    "criteria",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "staging-chat-run.v1"
    },
    "suite_run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "environment": {
      "const": "staging"
    },
    "chat_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "error"
      ]
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "turn",
          "role",
          "kind"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "turn": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "message",
              "tool_call",
              "tool_result"
            ]
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "arguments": {
            "type": [
              "object",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "tool_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "turn",
          "tool_name",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "turn": {
            "type": "integer",
            "minimum": 1
          },
          "tool_name": {
            "type": "string"
          },
          "tool_call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "missing_result"
            ]
          },
          "arguments": {
            "type": [
              "object",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "description",
          "severity",
          "required",
          "passed",
          "failure_reason",
          "root_cause_hint",
          "evidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "root_cause_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_count",
        "warning_count",
        "booking_created",
        "reception_task_created",
        "suspected_root_cause",
        "failure_reason",
        "transcript_excerpt"
      ],
      "properties": {
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "booking_created": {
          "type": "boolean"
        },
        "reception_task_created": {
          "type": "boolean"
        },
        "suspected_root_cause": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript_excerpt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  }
}
