{
  "version": 1,
  "tools": {
    "lookupPatient": {
      "schemaPath": "schemas/lookupPatient.vapi.request.json",
      "endpoint": "/webhook/ai-receptionist/lookup-patient",
      "description": "Use only when a phone number is ambiguous or incomplete and needs deterministic normalization.",
      "messages": [
        {
          "type": "request-start",
          "blocking": false
        },
        {
          "type": "request-failed",
          "content": "Przepraszam, nie udało mi się teraz potwierdzić numeru telefonu."
        }
      ],
      "variableExtractionPlan": {
        "aliases": [
          {
            "key": "confirmedPatientPhoneE164",
            "value": "{{ $.phone.normalizedE164 }}"
          },
          {
            "key": "confirmedPatientPhoneReadbackPrompt",
            "value": "{{ $.phone.readbackPrompt }}"
          }
        ]
      }
    },
    "checkAvailability": {
      "schemaPath": "schemas/checkAvailability.vapi.request.json",
      "endpoint": "/webhook/ai-receptionist/check-availability",
      "description": "Return availability. Use specific_time for exact hours and morning/afternoon/evening for broad windows. If caller gave time but no day, omit requestedDate. Use requestedDate plus searchDays 1 for one specific day. Use searchDays for bounded ranges like next week/month. Omit requestedDate/searchDays only for unbounded next available dates. Pass patient.isExistingPatient when known.",
      "messages": [
        {
          "type": "request-start",
          "content": "Już sprawdzam dostępne terminy.",
          "blocking": false
        },
        {
          "type": "request-response-delayed",
          "content": "Jeszcze chwila, sprawdzam kalendarz.",
          "timingMilliseconds": 3000
        },
        {
          "type": "request-failed",
          "content": "Przepraszam, mam chwilowy problem ze sprawdzeniem terminów."
        }
      ],
      "variableExtractionPlan": {
        "aliases": [
          {
            "key": "availabilityFound",
            "value": "{{ $.available }}"
          },
          {
            "key": "availabilityServiceId",
            "value": "{{ $.resolvedSearch.serviceId }}"
          },
          {
            "key": "availabilityStage",
            "value": "{{ $.resolvedSearch.stage }}"
          },
          {
            "key": "availabilityErrorCode",
            "value": "{{ $.error.code | default: \"\" }}"
          }
        ]
      }
    },
    "searchKnowledgeBase": {
      "schemaPath": "schemas/searchKnowledgeBase.request.json",
      "endpoint": "/webhook/ai-receptionist/search-knowledge-base",
      "description": "Answer non-medical clinic questions from the local knowledge base, including organization, services, and confirmed pricing. If the result is missing or uncertain, say so and do not invent details.",
      "messages": [
        {
          "type": "request-start",
          "content": "Już sprawdzam informacje.",
          "blocking": false
        },
        {
          "type": "request-response-delayed",
          "content": "Jeszcze chwila, wyszukuję potrzebne informacje.",
          "timingMilliseconds": 3000
        },
        {
          "type": "request-failed",
          "content": "Przepraszam, mam chwilowy problem z wyszukaniem tej informacji."
        }
      ],
      "variableExtractionPlan": {
        "aliases": [
          {
            "key": "kbFound",
            "value": "{{ $.found }}"
          },
          {
            "key": "kbTopCategory",
            "value": "{{ $.matches[0].category }}"
          },
          {
            "key": "kbErrorCode",
            "value": "{{ $.error.code | default: \"\" }}"
          }
        ]
      }
    },
    "createEvent": {
      "schemaPath": "schemas/createEvent.vapi.request.json",
      "endpoint": "/webhook/ai-receptionist/create-event",
      "description": "Create booking only after the caller selected one slot, confirmed the phone, and confirmed the summary. Pass exact slotStart and slotEnd plus service, timezone, language, full name, and a normalized or clear raw phone. Never confirm booking before success. Say result.message verbatim.",
      "parameters": [
        {
          "key": "patientPhoneE164",
          "value": "{{ confirmedPatientPhoneE164 }}"
        }
      ],
      "messages": [
        {
          "type": "request-start",
          "content": "Już zapisuję wizytę w kalendarzu.",
          "blocking": false
        },
        {
          "type": "request-response-delayed",
          "content": "Jeszcze moment, finalizuję rezerwację wizyty.",
          "timingMilliseconds": 3000
        },
        {
          "type": "request-failed",
          "content": "Przepraszam, nie udało mi się teraz zapisać wizyty."
        }
      ],
      "variableExtractionPlan": {
        "aliases": [
          {
            "key": "bookingCreated",
            "value": "{{ $.created }}"
          },
          {
            "key": "bookedServiceId",
            "value": "{{ $.appointment.service.id }}"
          },
          {
            "key": "bookingSmsStatus",
            "value": "{{ $.bookingConfirmationSms.delivery.status }}"
          },
          {
            "key": "bookingErrorCode",
            "value": "{{ $.error.code | default: \"\" }}"
          }
        ]
      }
    },
    "createReceptionTask": {
      "schemaPath": "schemas/createReceptionTask.request.json",
      "endpoint": "/webhook/ai-receptionist/create-reception-task",
      "description": "Create receptionist follow-up only after the caller name and phone are confirmed. Pass taskType, patient full name, a normalized or clear raw phone number, and only structured optional fields like serviceBucket or preferredCallbackWindow. Do not add free-text notes.",
      "parameters": [
        {
          "key": "patientPhoneE164",
          "value": "{{ confirmedPatientPhoneE164 }}"
        }
      ],
      "messages": [
        {
          "type": "request-start",
          "content": "Już zapisuję prośbę dla recepcji.",
          "blocking": false
        },
        {
          "type": "request-response-delayed",
          "content": "Jeszcze chwila, kończę zapisywać prośbę dla recepcji.",
          "timingMilliseconds": 1800
        },
        {
          "type": "request-failed",
          "content": "Przepraszam, nie udało mi się teraz zapisać prośby dla recepcji."
        }
      ],
      "variableExtractionPlan": {
        "aliases": [
          {
            "key": "receptionTaskAccepted",
            "value": "{{ $.accepted }}"
          },
          {
            "key": "receptionTaskType",
            "value": "{{ $.task.taskType }}"
          },
          {
            "key": "receptionTaskServiceBucket",
            "value": "{{ $.task.serviceBucket }}"
          },
          {
            "key": "receptionTaskErrorCode",
            "value": "{{ $.error.code | default: \"\" }}"
          }
        ]
      }
    },
    "sendSmsToReceptionists": {
      "schemaPath": "schemas/sendSmsToReceptionists.request.json",
      "endpoint": "/webhook/ai-receptionist/send-sms-to-receptionists",
      "description": "Send the internal receptionist SMS only after createReceptionTask succeeded and you have taskId. This is internal-only; if it fails, the saved reception task still exists.",
      "messages": [
        {
          "type": "request-start",
          "content": "Jeszcze chwila, kończę przekazywanie sprawy.",
          "blocking": false
        },
        {
          "type": "request-response-delayed",
          "content": "Jeszcze moment, dopinam przekazanie sprawy.",
          "timingMilliseconds": 1800
        }
      ]
    },
    "sendSmsToPatient": {
      "schemaPath": "schemas/sendSmsToPatient.request.json",
      "endpoint": "/webhook/ai-receptionist/send-sms-to-patient",
      "description": "Send a manual booking-confirmation SMS only after createEvent succeeded. Pass calendarEventId, patient identity, appointment timing, booked service, and prefer the live caller number when available."
    }
  }
}
